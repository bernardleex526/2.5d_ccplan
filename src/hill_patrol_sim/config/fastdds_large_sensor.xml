<?xml version="1.0" encoding="UTF-8"?>
<!--
  Explicit, session-only Fast DDS 2.6.12 profile for the native 1280x720,
  15 Hz depth cloud (22,118,400 payload bytes). The default 512 KiB SHM
  segment can recycle unread fragments; reserve 256 MiB per participant.
  UDPv4 remains available. Default maxMessageSize (65,500 bytes), discovery,
  reliability and history are unchanged; callers retain SensorDataQoS depth 5.
  Local SHM requires compatible same-host participants and shared-memory access;
  UDP availability does not promise remote delivery or provide transport security.
  Memory is per participant, not a single shared 256 MiB process-wide budget.

  Activate separately for the bridge AND every ROS consumer, using an absolute
  path (substitute your checkout path); no global configuration is installed:
  env RMW_IMPLEMENTATION=rmw_fastrtps_cpp \
      FASTRTPS_DEFAULT_PROFILES_FILE=/home/lee/hill_patrol_ws/src/hill_patrol_sim/config/fastdds_large_sensor.xml \
      <bridge-or-consumer-command>
  Gazebo native transport is unaffected. RMW_FASTRTPS_USE_QOS_FROM_XML is not
  required: this profile changes participant transports, not ROS endpoint QoS.
-->
<dds xmlns="http://www.eprosima.com">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>t14_sized_shm</transport_id>
        <type>SHM</type>
        <segment_size>268435456</segment_size>
      </transport_descriptor>
      <transport_descriptor>
        <transport_id>t14_udp</transport_id>
        <type>UDPv4</type>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="t14_sized_transport_participant" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>t14_sized_shm</transport_id>
          <transport_id>t14_udp</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
